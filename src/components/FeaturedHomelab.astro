---
import { getCollection } from 'astro:content';
const homelabPosts = (await getCollection('blog', ({ data }) => !data.draft && data.series === 'homelab'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const hasPosts = homelabPosts.length > 0;
---
<div class="pp-featured">
  <div class="pp-feat-head">
    <div class="pp-feat-dot"></div>
    <span class="pp-feat-tag">featured build</span>
    <span class="pp-feat-path">~/lab</span>
  </div>
  <div class="pp-feat-body">
    <div class="pp-feat-left">
      <div class="pp-feat-title">the homelab</div>
      <div class="pp-feat-desc">bare-metal kubernetes on a laptop. k3s, flux gitops, self-hosted apps, and everything that breaks along the way.</div>
      <a href="/series/homelab/" class="pp-feat-link">view the build &rarr;</a>
    </div>
    <div class="pp-feat-right">
      {hasPosts ? homelabPosts.map(post => (
        <a href={`/blog/${post.slug}/`} class="pp-feat-post">
          <span class="pp-feat-post-arrow">&rsaquo;</span>
          <span class="pp-feat-post-title">{post.data.title}</span>
        </a>
      )) : (
        <div class="pp-feat-empty">
          <div class="pp-feat-empty-line">$ ls ~/lab</div>
          <div class="pp-feat-empty-sub">build in progress. first logs landing soon.</div>
        </div>
      )}
    </div>
  </div>
</div>

<style>
  @keyframes ppGlow{0%,100%{box-shadow:0 0 16px #ff00ff18,0 0 6px #00d4ff18}50%{box-shadow:0 0 28px #ff00ff3a,0 0 12px #00d4ff3a}}
.pp-featured{background:#12121f;border:1px solid #ff00ff33;border-radius:6px;overflow:hidden;margin:0 0 8px;position:relative;animation:ppGlow 3s ease-in-out infinite}
.pp-featured::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#ff00ff,#00d4ff,#00ff9d);opacity:.9}
.pp-feat-head{background:#0a0a0f;border-bottom:1px solid #1a1a2e;padding:7px 14px;display:flex;align-items:center;gap:8px}
.pp-feat-dot{width:6px;height:6px;border-radius:50%;background:#00ff9d;animation:pulse 2s ease-in-out infinite}
.pp-feat-tag{color:#00ff9d;font-size:9px;letter-spacing:.12em;text-transform:uppercase;font-family:'Source Code Pro',monospace}
.pp-feat-path{color:#3a3a5a;font-size:9px;margin-left:auto;font-family:'Source Code Pro',monospace}
.pp-feat-body{display:flex;gap:24px;padding:20px 22px}
.pp-feat-left{flex:1;min-width:0}
@keyframes ppSweep{0%{background-position:0% 50%}100%{background-position:200% 50%}}
.pp-feat-title{font-size:24px;font-weight:700;margin-bottom:8px;font-family:'Source Code Pro',monospace;background:linear-gradient(90deg,#ff00ff,#00d4ff,#00ff9d,#ff00ff);background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:ppSweep 4s linear infinite}
.pp-feat-desc{color:#6a6a8a;font-size:12px;line-height:1.7;margin-bottom:16px;max-width:420px;font-family:'Source Code Pro',monospace}
.pp-feat-link{display:inline-block;color:#00d4ff;border:1px solid #00d4ff;border-radius:3px;padding:8px 14px;font-size:12px;text-decoration:none;font-family:'Source Code Pro',monospace;transition:all .2s}
.pp-feat-link:hover{background:#00d4ff12;text-decoration:none}
.pp-feat-right{width:280px;flex-shrink:0;display:flex;flex-direction:column;gap:6px;justify-content:center}
.pp-feat-post{display:flex;align-items:center;gap:8px;color:#c0c0d0;text-decoration:none;font-size:12px;padding:6px 8px;border-radius:3px;font-family:'Source Code Pro',monospace;transition:all .2s}
.pp-feat-post:hover{background:#0a0a12;color:#00ff9d;text-decoration:none}
.pp-feat-post-arrow{color:#ff00ff;flex-shrink:0}
.pp-feat-post-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pp-feat-empty{background:#0a0a0f;border:1px solid #1a1a2e;border-radius:4px;padding:14px 16px}
.pp-feat-empty-line{color:#00ff9d;font-size:12px;font-family:'Source Code Pro',monospace;margin-bottom:6px}
.pp-feat-empty-sub{color:#3a3a5a;font-size:11px;font-family:'Source Code Pro',monospace}
@media (max-width: 640px){
  .pp-feat-body{flex-direction:column;gap:16px;padding:16px}
  .pp-feat-right{width:100%}
}
</style>
