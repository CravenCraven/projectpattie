
---
import { getCollection } from 'astro:content';


const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(p => ({
    title: p.data.title,
    description: p.data.description,
    category: p.data.category,
    slug: p.slug,
  }));
---
<div class="pp-search">
  <div class="pp-search-label">// search the archive</div>
  <div class="pp-search-box">
    <span class="pp-search-prompt">$</span>
    <input type="text" id="ppSearchInput" class="pp-search-input" placeholder="search posts..." autocomplete="off" />
    <span class="pp-search-clear" id="ppSearchClear">esc</span>
  </div>
  <div class="pp-search-results" id="ppSearchResults"></div>
</div>

<script is:inline define:vars={{ posts }}>
  (function () {
    const input = document.getElementById('ppSearchInput');
    const results = document.getElementById('ppSearchResults');
    const clear = document.getElementById('ppSearchClear');
    if (!input) return;

    function render(list) {
      if (!list.length) {
        results.innerHTML = '<div class="pp-search-empty">no matches. try another term.</div>';
        results.classList.add('open');
        return;
      }
      results.innerHTML = list.slice(0, 8).map(p =>
        '<a class="pp-search-result" href="/blog/' + p.slug + '/">' +
        '<span class="pp-sr-arrow">&rsaquo;</span>' +
        '<span class="pp-sr-title">' + p.title + '</span>' +
        '<span class="pp-sr-cat">' + p.category + '</span>' +
        '</a>'
      ).join('');
      results.classList.add('open');
    }

    input.addEventListener('input', function () {
      const q = input.value.trim().toLowerCase();
      if (!q) { results.classList.remove('open'); results.innerHTML = ''; return; }
      const matches = posts.filter(p =>
        p.title.toLowerCase().includes(q) ||
        p.description.toLowerCase().includes(q) ||
        p.category.toLowerCase().includes(q)
      );
      render(matches);
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { input.value = ''; results.classList.remove('open'); results.innerHTML = ''; input.blur(); }
    });

    clear.addEventListener('click', function () {
      input.value = ''; results.classList.remove('open'); results.innerHTML = ''; input.focus();
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.pp-search')) { results.classList.remove('open'); }
    });
  })();
</script>

<style>
.pp-search{position:relative;margin:0 0 8px;font-family:'Source Code Pro',monospace}
.pp-search-label{color:#00d4ff;font-size:10px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:8px;font-family:'Source Code Pro',monospace}
.pp-search-box{display:flex;align-items:center;gap:10px;background:#12121f;border:1.5px solid #00d4ff88;border-radius:6px;padding:13px 16px;box-shadow:0 0 16px #00d4ff18;transition:border-color .2s,box-shadow .2s}
.pp-search-box:focus-within{border-color:#00d4ff;box-shadow:0 0 22px #00d4ff33}
.pp-search-prompt{color:#00ff9d;font-size:13px}
.pp-search-input{flex:1;background:transparent;border:none;outline:none;color:#e0e0f0;font-size:14px;font-family:'Source Code Pro',monospace}
.pp-search-input::placeholder{color:#3a3a5a}
.pp-search-clear{color:#3a3a5a;font-size:10px;border:1px solid #1a1a2e;border-radius:3px;padding:2px 6px;cursor:pointer}
.pp-search-clear:hover{color:#6a6a8a;border-color:#3a3a5a}
.pp-search-results{display:none;margin-top:6px;background:#0a0a0f;border:1px solid #1a1a2e;border-radius:6px;overflow:hidden}
.pp-search-results.open{display:block}
.pp-search-result{display:flex;align-items:center;gap:10px;padding:10px 14px;color:#c0c0d0;text-decoration:none;font-size:12px;border-bottom:1px solid #12121f;transition:all .15s}
.pp-search-result:last-child{border-bottom:none}
.pp-search-result:hover{background:#12121f;color:#00ff9d;text-decoration:none}
.pp-sr-arrow{color:#ff00ff;flex-shrink:0}
.pp-sr-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pp-sr-cat{color:#3a3a5a;font-size:10px;margin-left:auto;flex-shrink:0;letter-spacing:.05em}
.pp-search-empty{padding:12px 14px;color:#3a3a5a;font-size:12px}
</style>
