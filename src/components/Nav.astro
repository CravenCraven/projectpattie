---
const links = [
  { label: 'Sysadmin',     href: '/category/sysadmin' },
  { label: 'Cybersecurity',href: '/category/cybersecurity' },
  { label: 'HackerBox',    href: '/category/hackerbox' },
  { label: 'TryHackMe',    href: '/category/tryhackme' },
  { label: 'DevOps',       href: '/category/devops' },
  { label: 'Thoughts',     href: '/category/thoughts' },
  { label: 'About',        href: '/about' },
  { label: 'Contact',      href: '/contact' },
];

const current = Astro.url.pathname;
---

<style>
nav {
  border-bottom: 1px solid var(--border);
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(13,13,20,0.92);
  backdrop-filter: blur(8px);
}
.logo {
  font-size: 16px;
  font-weight: 700;
  color: var(--green);
  padding: 16px 0;
  white-space: nowrap;
}
.logo:hover { text-decoration: none; opacity: 0.8; }
.links {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  list-style: none;
}
.links a {
  display: block;
  padding: 16px 12px;
  font-size: 12px;
  color: var(--text-dim);
  letter-spacing: 0.5px;
  transition: color 0.2s;
}
.links a:hover,
.links a.active { color: var(--green); text-decoration: none; }
.hamburger {
  display: none;
  background: none;
  border: none;
  color: var(--text-dim);
  font-size: 18px;
  cursor: pointer;
  padding: 16px 0;
}
@media (max-width: 768px) {
  .hamburger { display: block; }
  .links {
    display: none;
    width: 100%;
    flex-direction: column;
    border-top: 1px solid var(--border);
    padding-bottom: 12px;
  }
  .links.open { display: flex; }
  .links a { padding: 10px 0; }
}
</style>

<nav>
  <a href="/" class="logo">projectpattie;</a>
  <button class="hamburger" id="menu-btn" aria-label="Toggle menu">&#9776;</button>
  <ul class="links" id="nav-links">
    {links.map(l => (
      <li>
        <a href={l.href} class={current.startsWith(l.href) ? 'active' : ''}>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('nav-links');
  btn?.addEventListener('click', () => nav?.classList.toggle('open'));
</script>