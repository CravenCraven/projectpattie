---
const links = [
  { label: 'sysadmin',      href: '/category/sysadmin' },
  { label: 'cybersecurity', href: '/category/cybersecurity' },
  { label: 'hackerbox',     href: '/category/hackerbox' },
  { label: 'tryhackme',     href: '/category/tryhackme' },
  { label: 'devops',        href: '/category/devops' },
  { label: 'thoughts',      href: '/category/thoughts' },
  { label: 'about',         href: '/about' },
  { label: 'contact',       href: '/contact' },
];
const current = Astro.url.pathname;
---

<style>
nav {
  background: #0f0f1a;
  border-bottom: 1px solid #1a1a2e;
  padding: 0 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  position: sticky;
  top: 0;
  z-index: 100;
}
.logo {
  font-size: 15px;
  font-weight: 700;
  color: #00ff9d;
  padding: 16px 0;
  white-space: nowrap;
  font-family: 'Source Code Pro', monospace;
  text-decoration: none;
}
.logo:hover { opacity: 0.8; text-decoration: none; }
.links {
  display: flex;
  flex-wrap: wrap;
  list-style: none;
  margin: 0;
  padding: 0;
}
.links a {
  display: block;
  padding: 16px 10px;
  font-size: 11px;
  color: #4a4a6a;
  font-family: 'Source Code Pro', monospace;
  letter-spacing: .05em;
  transition: color 0.2s;
  text-decoration: none;
}
.links a:hover,
.links a.active { color: #00ff9d; text-decoration: none; }
.hamburger {
  display: none;
  background: none;
  border: none;
  color: #4a4a6a;
  font-size: 18px;
  cursor: pointer;
  padding: 16px 0;
}
@media (max-width: 768px) {
  .hamburger { display: block; }
  .links { display: none; width: 100%; flex-direction: column; border-top: 1px solid #1a1a2e; padding-bottom: 12px; }
  .links.open { display: flex; }
  .links a { padding: 10px 0; }
}
</style>

<nav>
  <a href="/" class="logo">projectpattie;</a>
  <button class="hamburger" id="menu-btn" aria-label="Toggle menu">&#9776;</button>
  <ul class="links" id="nav-links">
    {links.map(l => (
      <li>
        <a href={l.href} class={current.startsWith(l.href) ? 'active' : ''}>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('nav-links');
  btn?.addEventListener('click', () => nav?.classList.toggle('open'));
</script>