---
const year = new Date().getFullYear();
---

<style>
footer {
  border-top: 1px solid var(--bd);
  padding: 32px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  font-size: 12px;
  color: var(--dimmer);
}
.footer-links { display: flex; gap: 20px; }
.footer-links a { color: var(--dimmer); transition: color 0.2s; }
.footer-links a:hover { color: var(--a1); text-decoration: none; }
</style>

<footer>
  <span>© {year} projectpattie.com</span>
  <div class="footer-links">
    <a href="/feed.xml">[ rss feed ]</a>
    <a href="https://github.com/CravenCraven" target="_blank" rel="noopener">[ github ]</a>
  </div>
</footer>