---
interface Props {
  title: string;
  description: string;
  slug: string;
  date: Date;
  category: string;
  readTime?: number;
}
const { title, description, slug, date, category, readTime = 5 } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' });
---

<style>
.post-card {
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 24px;
  transition: border-color 0.2s;
  display: block;
  color: inherit;
}
.post-card:hover { border-color: var(--green); text-decoration: none; }
.meta {
  font-size: 11px;
  color: var(--text-dim);
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 10px;
}
.meta .cat { color: var(--green); }
.post-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-head);
  margin-bottom: 10px;
  line-height: 1.3;
}
.desc {
  font-size: 13px;
  color: var(--text-dim);
  line-height: 1.7;
  margin: 0;
}
.read-more {
  display: inline-block;
  margin-top: 14px;
  font-size: 12px;
  color: var(--green);
}
</style>

<a href={`/blog/${slug}`} class="post-card">
  <div class="meta">
    <span class="cat">{category}</span> · {dateStr} · {readTime} min read
  </div>
  <div class="post-title">{title}</div>
  <p class="desc">{description}</p>
  <span class="read-more">read more →</span>
</a>