---
interface Props {
  title: string;
  description: string;
  slug: string;
  date: Date;
  category: string;
  readTime?: number;
}
const { title, description, slug, date, category, readTime = 5 } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' });
---

<style>
.post-card {
  --pf: var(--calamine); --po: var(--on-calamine);
  border: 0;
  border-radius: 8px;
  padding: 0 24px 24px;
  display: block;
  color: inherit;
  background: var(--card);
  overflow: hidden;
}
.post-card:nth-child(4n+2) { --pf: var(--cobalt); --po: var(--on-cobalt); }
.post-card:nth-child(4n+3) { --pf: var(--greenblue); --po: var(--on-greenblue); }
.post-card:nth-child(4n+4) { --pf: var(--sea); --po: var(--on-sea); }
.post-card:hover { outline: 3px solid var(--lime); text-decoration: none; }
.meta {
  font-size: 11px;
  font-weight: 700;
  color: var(--po);
  background: var(--pf);
  letter-spacing: 1px;
  text-transform: uppercase;
  margin: 0 -24px 16px;
  padding: 9px 24px;
}
.meta .cat { color: var(--on-pom); background: var(--pom); padding: 1px 7px; border-radius: 3px; }
.post-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--head);
  margin-bottom: 10px;
  line-height: 1.3;
}
.desc {
  font-size: 13px;
  color: var(--tx);
  line-height: 1.7;
  margin: 0;
}
.read-more {
  display: inline-block;
  margin-top: 14px;
  font-size: 12px;
  font-weight: 700;
  color: var(--on-lime);
  background: var(--lime);
  padding: 3px 10px;
  border-radius: 4px;
}
</style>

<a href={`/blog/${slug}`} class="post-card">
  <div class="meta">
    <span class="cat">{category}</span> · {dateStr} · {readTime} min read
  </div>
  <div class="post-title">{title}</div>
  <p class="desc">{description}</p>
  <span class="read-more">read more →</span>
</a>