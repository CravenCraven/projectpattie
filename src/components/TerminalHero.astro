---
---
<style>
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
@keyframes scan{0%{top:0}50%{top:100%}100%{top:0}}
@keyframes ppScrollLeft{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
@keyframes glitchFlash{0%{opacity:.7;background:linear-gradient(0deg,transparent 40%,#ff00ff10 41%,transparent 42%,transparent 58%,#00d4ff10 59%,transparent 60%)}30%{opacity:.5;transform:translateX(2px)}60%{opacity:.4;transform:translateX(-1px)}100%{opacity:0;transform:translateX(0)}}

.pp-hero-wrap{background:#0f0f1a;padding:40px 28px 36px;position:relative;overflow:hidden;border-bottom:1px solid #1a1a2e}
.pp-hero-grid{position:absolute;top:0;left:0;right:0;bottom:0;background-image:linear-gradient(rgba(0,255,157,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,255,157,.03) 1px,transparent 1px);background-size:40px 40px;pointer-events:none}
.pp-hero-scan{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#00d4ff80,transparent);animation:scan 4s ease-in-out infinite;opacity:.3}
.pp-hero-ghost{position:absolute;top:8px;right:20px;font-size:9px;line-height:1.5;color:#00d4ff;opacity:.06;pointer-events:none;text-align:right;font-family:'Source Code Pro',monospace}
.pp-hero-prompt{color:#00ff9d;font-size:12px;margin-bottom:12px;position:relative;font-family:'Source Code Pro',monospace}
.pp-hero-prompt .tilde{color:#ff00ff}
.pp-hero-h1{color:#e0e0f0;font-size:28px;font-weight:bold;line-height:1.35;margin-bottom:14px;position:relative;font-family:'Source Code Pro',monospace}
.pp-hero-h1 .accent{color:#ff00ff}
.pp-hero-h1 .cursor{display:inline-block;width:12px;height:24px;background:#00d4ff;vertical-align:middle;margin-left:4px;animation:blink 1s step-end infinite}
.pp-hero-desc{color:#6a6a8a;font-size:13px;line-height:1.8;max-width:500px;position:relative;margin-bottom:24px;font-family:'Source Code Pro',monospace}
.pp-hero-row{display:flex;gap:20px;position:relative;align-items:flex-start}
.pp-glitch-box{flex:1;background:#12121f;border:1px solid #1a1a2e;border-radius:6px;padding:16px 18px;position:relative;overflow:hidden;min-height:110px}
.pp-glitch-box::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,#ff00ff40,transparent)}
.pp-gb-label{display:flex;align-items:center;gap:6px;margin-bottom:12px}
.pp-gb-dot{width:5px;height:5px;border-radius:50%;background:#00ff9d;animation:pulse 2s ease-in-out infinite}
.pp-gb-tag{color:#00ff9d;font-size:9px;letter-spacing:.1em;text-transform:uppercase;font-family:'Source Code Pro',monospace}
.pp-mini-term{background:#0a0a0f;border:1px solid #1a1a2e;border-radius:6px;overflow:hidden;width:260px;flex-shrink:0}
.pp-mt-head{background:#12121f;border-bottom:1px solid #1a1a2e;padding:6px 12px;display:flex;align-items:center;gap:5px}
.pp-mt-dot{width:7px;height:7px;border-radius:50%}
.pp-mt-title{color:#3a3a5a;font-size:9px;margin-left:6px;font-family:'Source Code Pro',monospace}
.pp-mt-body{padding:12px 14px;font-size:11px;line-height:1.9;font-family:'Source Code Pro',monospace;position:relative;height:140px;overflow:hidden}
.pp-mt-slide{position:absolute;left:14px;right:14px;top:12px;transition:opacity .5s,transform .5s}
.pp-mt-slide.hide{opacity:0;transform:translateY(-10px)}
.tg{color:#00ff9d}.tc{color:#00d4ff}.tm{color:#ff00ff}.td{color:#3a3a5a}.to{color:#ff9d00}
.mt-cur{display:inline-block;width:7px;height:12px;background:#00ff9d;vertical-align:middle;animation:blink 1s step-end infinite}

/* DATA STRIP */
.pp-data-strip{height:36px;background:#0a0a0f;border-top:1px solid #1a1a2e;border-bottom:1px solid #1a1a2e;position:relative;overflow:hidden;display:flex;align-items:center;margin:0 -28px}
.pp-data-strip::before{content:'';position:absolute;left:0;top:0;bottom:0;width:40px;background:linear-gradient(90deg,#0a0a0f,transparent);z-index:1}
.pp-data-strip::after{content:'';position:absolute;right:0;top:0;bottom:0;width:40px;background:linear-gradient(270deg,#0a0a0f,transparent);z-index:1}
.pp-ds-scroll{display:flex;gap:28px;animation:ppScrollLeft 25s linear infinite;white-space:nowrap;padding:0 20px}
.pp-ds-hex{color:#00ff9d;font-size:10px;opacity:.35;font-family:'Source Code Pro',monospace}
.pp-ds-cmd{color:#00d4ff;font-size:10px;opacity:.25;font-family:'Source Code Pro',monospace}
.pp-ds-addr{color:#ff00ff;font-size:10px;opacity:.25;font-family:'Source Code Pro',monospace}
.pp-ds-num{color:#ff9d00;font-size:10px;opacity:.35;font-family:'Source Code Pro',monospace}

/* SECTIONS */
.pp-section-label{color:#00d4ff;font-size:11px;letter-spacing:.12em;text-transform:uppercase;margin:28px 0 14px;font-family:'Source Code Pro',monospace}
.pp-section-label .dim{color:#4a4a6a}
.pp-section-label-m{color:#ff00ff;font-size:11px;letter-spacing:.12em;text-transform:uppercase;margin:28px 0 14px;font-family:'Source Code Pro',monospace}
.pp-section-label-m .dim{color:#4a4a6a}

/* CATEGORIES */
.pp-cat-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-bottom:0}
.pp-cat-link{display:block;background:#12121f;border:1px solid #1a1a2e;border-radius:4px;padding:12px 6px;text-align:center;font-size:11px;color:#6a6a8a;text-decoration:none;font-family:'Source Code Pro',monospace;transition:all .2s}
.pp-cat-link:hover{border-color:#00ff9d;color:#00ff9d;text-decoration:none}
.pp-cat-count{display:block;font-size:9px;color:#3a3a5a;margin-top:4px;letter-spacing:.05em}
.pp-cat-soon{display:block;background:#0a0a12;border:1px dashed #1a1a2e;border-radius:4px;padding:12px 6px;text-align:center;font-size:11px;color:#3a3a5a;font-family:'Source Code Pro',monospace;cursor:not-allowed;opacity:.65}
.pp-cat-soon .pp-cat-count{color:#ff9d00}

/* QUOTE */
.pp-quote-block{background:#12121f;border:1px solid #1a1a2e;border-radius:6px;overflow:hidden;margin:28px 0}
.pp-q-head{background:#0a0a0f;border-bottom:1px solid #1a1a2e;padding:6px 14px;display:flex;align-items:center;gap:5px}
.pp-q-dot{width:7px;height:7px;border-radius:50%}
.pp-q-title{color:#3a3a5a;font-size:9px;margin-left:6px;font-family:'Source Code Pro',monospace}
.pp-q-body{padding:16px 18px;position:relative;min-height:62px}
.pp-q-slide{position:absolute;left:18px;right:18px;top:16px;transition:opacity .5s,transform .5s;font-family:'Source Code Pro',monospace}
.pp-q-slide.hide{opacity:0;transform:translateY(-8px);pointer-events:none}
.pp-q-text{color:#e0e0f0;font-size:13px;line-height:1.6;font-style:italic;margin-bottom:6px;font-family:'Source Code Pro',monospace}
.pp-q-attr{color:#ff9d00;font-size:11px;font-family:'Source Code Pro',monospace}

/* FOLLOW */
.pp-follow-block{background:#12121f;border:1px solid #1a1a2e;border-radius:6px;padding:24px;margin:20px 0;position:relative;overflow:hidden}
.pp-follow-block::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,#ff00ff,#00d4ff);opacity:.4}
.pp-follow-row{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.pp-follow-label{color:#ff00ff;font-size:11px;letter-spacing:.1em;margin-bottom:6px;font-family:'Source Code Pro',monospace}
.pp-follow-desc{color:#6a6a8a;font-size:12px;font-family:'Source Code Pro',monospace}
.pp-follow-links{display:flex;gap:8px;flex-wrap:wrap}
.pp-follow-link{display:inline-flex;align-items:center;gap:6px;background:transparent;color:#00ff9d;border:1px solid #00ff9d;border-radius:3px;padding:9px 14px;font-size:12px;font-family:'Source Code Pro',monospace;text-decoration:none;transition:all .2s}
.pp-follow-link:hover{background:#00ff9d12;color:#00ff9d;text-decoration:none}
.pp-follow-link.soon{color:#3a3a5a;border-color:#1a1a2e;border-style:dashed;cursor:not-allowed;pointer-events:none}
.pp-fl-tag{font-size:8px;opacity:.7;letter-spacing:.05em}
</style>

<!-- HERO -->
<div class="pp-hero-wrap">
  <div class="pp-hero-grid"></div>
  <div class="pp-hero-scan"></div>
  <div class="pp-hero-ghost">0x7ff3a2b8c000<br>mov rdi, rsp<br>call _start<br>jmp 0xdeadbeef<br>xor eax, eax<br>push rbp<br>syscall<br>ret<br>nop<br>int 0x80</div>
  <div class="pp-hero-prompt">root@pattie <span class="tilde">~</span></div>
  <h1 class="pp-hero-h1">notes from the <span class="accent">terminal</span><span class="cursor"></span></h1>
  <div class="pp-hero-desc">A sysadmin and cybersecurity learning log. Documenting labs, CTFs, HackerBox builds, and the occasional late-night rabbit hole.</div>
  <div class="pp-hero-row">
    <div class="pp-glitch-box">
      <div class="pp-gb-label"><div class="pp-gb-dot"></div><span class="pp-gb-tag">about this site</span></div>
      <div style="font-size:12px;line-height:1.7;font-family:'Source Code Pro',monospace;color:#c0c0d0">
        <div style="color:#e0e0f0;margin-bottom:6px">notes + writeups from a sysadmin learning offensive security</div>
        <div style="color:#6a6a8a;font-size:11px;line-height:1.6">expect: lab builds, ctf writeups, hardening guides, and the occasional rabbit hole. no fluff.</div>
      </div>
    </div>
    <div class="pp-mini-term">
      <div class="pp-mt-head">
        <div class="pp-mt-dot" style="background:#ff5f57"></div>
        <div class="pp-mt-dot" style="background:#febc2e"></div>
        <div class="pp-mt-dot" style="background:#28c840"></div>
        <span class="pp-mt-title">session.sh</span>
      </div>
      <div class="pp-mt-body">
        <div class="pp-mt-slide" id="ppS0"><div><span class="tg">$</span> <span class="tc">whoami</span></div><div><span class="td">craven</span></div><div><span class="td">sysadmin learning</span></div><div><span class="td">offensive security</span></div><div><span class="tg">$</span> <span class="mt-cur"></span></div></div>
        <div class="pp-mt-slide hide" id="ppS1"><div><span class="tg">$</span> <span class="tc">cat</span> ~/.philosophy</div><div><span class="tm">break things on purpose</span></div><div><span class="to">break them better</span></div><div><span class="to">next time</span></div><div><span class="tg">$</span> <span class="mt-cur"></span></div></div>
        <div class="pp-mt-slide hide" id="ppS2"><div><span class="tg">$</span> <span class="tc">ls</span> -la /lab</div><div><span class="to">rhel9-homelab/</span></div><div><span class="tm">pentest-rig/</span></div><div><span class="tc">firewall-bench/</span></div><div><span class="tg">$</span> <span class="mt-cur"></span></div></div>
        <div class="pp-mt-slide hide" id="ppS3"><div><span class="tg">$</span> <span class="tc">history</span> | tail -3</div><div><span class="td">nmap -sV target</span></div><div><span class="td">journalctl -f</span></div><div><span class="td">vim sshd_config</span></div><div><span class="tg">$</span> <span class="mt-cur"></span></div></div>
        <div class="pp-mt-slide hide" id="ppS4"><div><span class="tg">$</span> <span class="tc">tail</span> /var/log/learning</div><div><span class="tg">[OK]</span> <span class="td">zero trust documented</span></div><div><span class="to">[WARN]</span> <span class="td">root login disabled</span></div><div><span class="tg">[OK]</span> <span class="td">still curious</span></div><div><span class="tg">$</span> <span class="mt-cur"></span></div></div>
      </div>
    </div>
  </div>
</div>

<!-- DATA STRIP -->
<div class="pp-data-strip">
  <div class="pp-ds-scroll">
    <span class="pp-ds-hex">0xDEADBEEF</span><span class="pp-ds-cmd">sudo systemctl restart sshd</span><span class="pp-ds-addr">192.168.1.50:22</span><span class="pp-ds-num">chmod 2770</span><span class="pp-ds-hex">0x7FF3A2B8C000</span><span class="pp-ds-cmd">nmap -sV -sC target</span><span class="pp-ds-addr">10.10.14.12:4444</span><span class="pp-ds-num">uid=0(root)</span><span class="pp-ds-hex">0xCAFEBABE</span><span class="pp-ds-cmd">docker compose up -d</span><span class="pp-ds-addr">172.16.0.1:8080</span><span class="pp-ds-num">-rwxrws---</span><span class="pp-ds-hex">0xDEADBEEF</span><span class="pp-ds-cmd">sudo systemctl restart sshd</span><span class="pp-ds-addr">192.168.1.50:22</span><span class="pp-ds-num">chmod 2770</span><span class="pp-ds-hex">0x7FF3A2B8C000</span><span class="pp-ds-cmd">nmap -sV -sC target</span><span class="pp-ds-addr">10.10.14.12:4444</span><span class="pp-ds-num">uid=0(root)</span>
  </div>
</div>

<script>
var ppTc=0,ppTt=5;
setInterval(function(){document.getElementById('ppS'+ppTc).classList.add('hide');ppTc=(ppTc+1)%ppTt;document.getElementById('ppS'+ppTc).classList.remove('hide')},3500);
var ppQc=0,ppQt=8;
setInterval(function(){document.getElementById('ppQ'+ppQc).classList.add('hide');ppQc=(ppQc+1)%ppQt;document.getElementById('ppQ'+ppQc).classList.remove('hide')},7000);
</script>