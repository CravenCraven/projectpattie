---
interface Props {
  title: string;
  date: Date;
  section: string;
  confidence: number;
  timeSpent?: string;
  tags?: string[];
  difficulty?: string;
  energy?: string;
  nextGoal?: string;
}

const {
  title,
  date,
  section,
  confidence,
  timeSpent,
  tags = [],
  difficulty,
  energy,
  nextGoal,
} = Astro.props;
const dateStr = date.toISOString().split('T')[0];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} // kubecraft — projectpattie;</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="kc-ticker">
    <div class="kc-ticker-inner">
      <span>kubectl</span> get pods -A &nbsp;|&nbsp; <span>kubecraft</span> journal &nbsp;|&nbsp; <span>0xCAFEBABE</span> &nbsp;|&nbsp; docker compose up -d &nbsp;|&nbsp; <span>helm</span> install ingress-nginx &nbsp;|&nbsp; chmod 2770 &nbsp;|&nbsp;
      <span>kubectl</span> get pods -A &nbsp;|&nbsp; <span>kubecraft</span> journal &nbsp;|&nbsp; <span>0xCAFEBABE</span> &nbsp;|&nbsp; docker compose up -d &nbsp;|&nbsp; <span>helm</span> install ingress-nginx &nbsp;|&nbsp; chmod 2770 &nbsp;|&nbsp;
    </div>
  </div>

  <nav class="kc-nav">
    <a href="/" class="kc-logo">projectpattie<em>;</em></a>
    <div class="kc-nav-links">
      <a href="/sysadmin">sysadmin</a>
      <a href="/cybersecurity">cybersecurity</a>
      <a href="/hackerbox">hackerbox</a>
      <a href="/tryhackme">tryhackme</a>
      <a href="/devops">devops</a>
      <a href="/kubecraft" class="active">kubecraft</a>
      <a href="/thoughts">thoughts</a>
      <a href="/about">about</a>
    </div>
  </nav>

  <div class="kc-container">
    <a href="/kubecraft" class="kc-back">&larr; back to journal</a>
    <div class="kc-prompt"><span class="u">root@pattie</span> ~ <span class="p">/kubecraft</span></div>
    <h1 class="kc-title">{title}</h1>

    <div class="kc-meta">
      <div class="kc-mi"><span class="kc-mk">section</span><span class="kc-mv">{section}</span></div>
      <div class="kc-mi"><span class="kc-mk">date</span><span class="kc-mv">{dateStr}</span></div>
      {timeSpent && <div class="kc-mi"><span class="kc-mk">time spent</span><span class="kc-mv">{timeSpent}</span></div>}
      <div class="kc-mi">
        <span class="kc-mk">confidence</span>
        <div class="kc-conf">
          {[1,2,3,4,5].map(i => <div class={`kc-dot ${i <= confidence ? 'on' : ''}`}></div>)}
        </div>
      </div>
      {difficulty && <div class="kc-mi"><span class="kc-mk">difficulty</span><span class="kc-mv yellow">{difficulty}</span></div>}
      {energy && <div class="kc-mi"><span class="kc-mk">energy</span><span class="kc-mv">{energy}</span></div>}
    </div>

    {tags.length > 0 && (
      <div class="kc-tags">
        {tags.map(t => <span class="kc-tag">{t}</span>)}
      </div>
    )}

    <article class="kc-content">
      <slot />
    </article>

    {nextGoal && (
      <div class="kc-next">next session goal &rarr; <span>{nextGoal}</span></div>
    )}
  </div>

  <style is:global>
    :root{--bg:#0d0f0f;--bg2:#111416;--bg3:#161a1b;--border:#1e2526;--border2:#243032;--cyan:#00e5c8;--magenta:#ff2d9b;--green:#39ff6e;--yellow:#f5c518;--dim:#4a5a5c;--muted:#6b8082;--text:#c8d8da;--text2:#e8f0f1;--mono:'JetBrains Mono',monospace}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{background:var(--bg);color:var(--text);font-family:var(--mono);font-size:14px;line-height:1.7;min-height:100vh}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(0,229,200,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,229,200,0.03) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0}

    /* ticker */
    .kc-ticker{background:var(--bg2);border-bottom:1px solid var(--border2);overflow:hidden;padding:6px 0;position:sticky;top:0;z-index:100}
    .kc-ticker-inner{display:flex;gap:60px;white-space:nowrap;animation:kc-ticker 28s linear infinite;font-size:11px;color:var(--dim)}
    .kc-ticker-inner span{color:var(--cyan)}
    @keyframes kc-ticker{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

    /* nav */
    .kc-nav{display:flex;justify-content:space-between;align-items:center;padding:18px 40px;border-bottom:1px solid var(--border);position:relative;z-index:10}
    .kc-logo{color:var(--cyan);font-size:15px;font-weight:700;text-decoration:none}
    .kc-logo em{color:var(--magenta);font-style:normal}
    .kc-nav-links{display:flex;gap:28px;flex-wrap:wrap}
    .kc-nav a{color:var(--muted);text-decoration:none;font-size:12px;letter-spacing:0.08em;transition:color 0.2s}
    .kc-nav a:hover,.kc-nav a.active{color:var(--cyan)}

    /* layout */
    .kc-container{max-width:860px;margin:0 auto;padding:40px 40px 80px;position:relative;z-index:1}
    .kc-back{display:inline-flex;align-items:center;gap:6px;color:var(--muted);text-decoration:none;font-size:11px;margin-bottom:24px;transition:color 0.2s}
    .kc-back:hover{color:var(--cyan)}
    .kc-prompt{color:var(--muted);font-size:12px;margin-bottom:8px}
    .kc-prompt .u{color:var(--green)}.kc-prompt .p{color:var(--cyan)}
    .kc-title{font-size:26px;font-weight:700;color:var(--text2);margin-bottom:24px;letter-spacing:-0.02em}
    /* blinking magenta cursor after the title */
    .kc-title::after{content:'';display:inline-block;width:9px;height:0.85em;background:var(--magenta);vertical-align:middle;margin-left:8px;animation:kc-blink 1s step-end infinite}
    @keyframes kc-blink{0%,100%{opacity:1}50%{opacity:0}}

    /* meta row */
    .kc-meta{display:flex;flex-wrap:wrap;gap:20px;padding:20px 24px;background:var(--bg2);border:1px solid var(--border);border-radius:4px;margin-bottom:14px}
    .kc-mi{display:flex;flex-direction:column;gap:4px}
    .kc-mk{font-size:10px;letter-spacing:0.1em;color:var(--dim);text-transform:uppercase}
    .kc-mv{font-size:13px;color:var(--text2)}
    .kc-mv.yellow{color:var(--yellow)}
    .kc-conf{display:flex;gap:5px;margin-top:4px}
    .kc-dot{width:9px;height:9px;border-radius:50%;background:var(--border2)}
    .kc-dot.on{background:var(--cyan);box-shadow:0 0 4px var(--cyan)}

    /* tags */
    .kc-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px}
    .kc-tag{font-size:11px;padding:3px 10px;border-radius:2px;border:1px solid var(--border2);color:var(--muted);transition:color 0.2s,border-color 0.2s,box-shadow 0.2s}
    .kc-tag:hover{color:var(--cyan);border-color:var(--cyan);box-shadow:0 0 8px color-mix(in srgb, var(--cyan) 35%, transparent)}

    /* next-session-goal footer */
    .kc-next{margin-top:32px;padding:14px 20px;border:1px solid var(--border2);border-radius:4px;font-size:12px;color:var(--dim)}
    .kc-next span{color:var(--cyan)}

    /* ── markdown body ── */
    .kc-content{position:relative;z-index:1;animation:kc-rise 0.5s ease both}
    @keyframes kc-rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

    /* h2 section labels — cycle accent bar + text through the palette */
    .kc-content h2{position:relative;padding-left:16px;font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--cyan);margin:38px 0 12px;display:flex;align-items:center;gap:8px}
    .kc-content h2::before{content:'//';color:var(--dim)}
    .kc-content h2::after{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);width:3px;height:1em;border-radius:2px;background:var(--cyan)}
    .kc-content h2:nth-of-type(5n+1){color:var(--cyan)}
    .kc-content h2:nth-of-type(5n+1)::after{background:var(--cyan)}
    .kc-content h2:nth-of-type(5n+2){color:var(--magenta)}
    .kc-content h2:nth-of-type(5n+2)::after{background:var(--magenta)}
    .kc-content h2:nth-of-type(5n+3){color:var(--green)}
    .kc-content h2:nth-of-type(5n+3)::after{background:var(--green)}
    .kc-content h2:nth-of-type(5n+4){color:var(--yellow)}
    .kc-content h2:nth-of-type(5n+4)::after{background:var(--yellow)}
    .kc-content h2:nth-of-type(5n){color:var(--magenta)}
    .kc-content h2:nth-of-type(5n)::after{background:var(--magenta)}

    .kc-content h3{font-size:12px;font-weight:400;color:var(--muted);letter-spacing:0.04em;margin:20px 0 8px}
    .kc-content p{font-size:13px;color:var(--text);line-height:1.85;margin:0 0 14px}
    .kc-content ul,.kc-content ol{padding-left:22px;margin:0 0 14px}
    .kc-content li{font-size:13px;margin-bottom:6px}
    .kc-content li::marker{color:var(--dim)}
    .kc-content strong{color:var(--text2);font-weight:700}
    .kc-content a{color:var(--cyan);text-decoration:none;transition:text-shadow 0.2s}
    .kc-content a:hover{text-decoration:underline;text-shadow:0 0 8px color-mix(in srgb, var(--cyan) 70%, transparent)}
    .kc-content hr{border:none;border-top:1px solid var(--border);margin:28px 0}

    /* inline code — green on a faint green tint */
    .kc-content :not(pre) > code{color:var(--green);background:color-mix(in srgb, var(--green) 10%, transparent);border:1px solid color-mix(in srgb, var(--green) 25%, transparent);border-radius:3px;padding:1px 6px;font-size:12px;font-family:var(--mono)}

    /* code window — macOS chrome (dots via ::after, language label via ::before) */
    .kc-content pre{position:relative;background:var(--bg) !important;border:1px solid var(--border2);border-radius:4px;margin:16px 0;padding:42px 16px 14px;overflow-x:auto;font-size:12px;line-height:1.8}
    .kc-content pre::before{content:attr(data-language);position:absolute;top:0;left:0;right:0;height:30px;display:flex;align-items:center;justify-content:flex-end;padding:0 14px;background:var(--bg3);border-bottom:1px solid var(--border);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--magenta);font-family:var(--mono)}
    .kc-content pre::after{content:'';position:absolute;top:11px;left:14px;width:8px;height:8px;border-radius:50%;background:#ff5f56;box-shadow:14px 0 0 #ffbd2e,28px 0 0 #27c93f}
    .kc-content pre code{background:none;border:none;padding:0;font-size:12px;font-family:var(--mono)}

    /* blockquote — magenta callout bar with a faint tint */
    .kc-content blockquote{background:color-mix(in srgb, var(--magenta) 7%, var(--bg2));border-left:3px solid var(--magenta);border-radius:0 4px 4px 0;padding:14px 18px;margin:18px 0;color:var(--muted)}
    .kc-content blockquote p{margin:0;font-size:13px}
    .kc-content blockquote strong{color:var(--magenta)}
  </style>
</body>
</html>
