---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  readTime?: number;
}

const { title, description, date, category, readTime = 5 } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' });
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — projectpattie;</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--tx); font-family: 'Source Code Pro', 'JetBrains Mono', monospace; font-size: 15px; line-height: 1.85; -webkit-font-smoothing: antialiased; }
    .pp-article { max-width: 740px; margin: 0 auto; padding: 60px 24px 100px; }
    .pp-meta { color: var(--dimmer); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 40px; }
    .pp-meta span { color: var(--a1); }
    .pp-title { font-size: clamp(28px, 5vw, 42px); font-weight: 700; color: var(--head); line-height: 1.2; margin-bottom: 12px; }
    .pp-title em { color: var(--a3); font-style: normal; }
    .pp-subtitle { color: var(--dim); font-size: 15px; line-height: 1.7; margin-bottom: 50px; }
    /* series nav */
    .pp-series { background: var(--bg2); border: 1px solid var(--bd); border-radius: 6px; padding: 20px 24px; margin-bottom: 30px; }
    .pp-series-label { color: var(--a3); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px; font-weight: 600; }
    .pp-series ol { list-style: none; padding: 0; counter-reset: series; }
    .pp-series li { counter-increment: series; margin-bottom: 6px; font-size: 13px; color: var(--dimmer); }
    .pp-series li::before { content: "Part " counter(series) ":"; color: var(--dimmer); margin-right: 8px; font-size: 12px; }
    .pp-series li.active { color: var(--head); }
    .pp-series li.active::before { color: var(--a1); }
    .pp-series li.active::after { content: " ← you are here"; color: var(--a1); font-size: 11px; }
    .pp-series li a { color: var(--tx); text-decoration: none; transition: color .18s ease; }
    .pp-series li a:hover { color: var(--a1); text-decoration: none; }
    /* toc — styled like a terminal card with mac dots */
    .pp-toc { background: var(--bg2); border: 1px solid var(--bd); border-radius: 6px; padding: 0; margin: 30px 0 50px; overflow: hidden; }
    .pp-toc-label { background: var(--card); border-bottom: 1px solid var(--bd); padding: 11px 18px 11px 56px; margin: 0; color: var(--dimmer); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; font-family: 'Source Code Pro', monospace; position: relative; }
    .pp-toc-label::before { content: ''; position: absolute; top: 50%; left: 18px; width: 7px; height: 7px; border-radius: 50%; background: var(--dot1); transform: translateY(-50%); box-shadow: 12px 0 0 var(--dot2), 24px 0 0 var(--dot3); }
    .pp-toc-label span { color: var(--a1); }
    .pp-toc ol { padding: 18px 22px; margin: 0; counter-reset: toc; list-style: none; }
    .pp-toc li { counter-increment: toc; margin: 0; padding: 5px 8px 5px 0; position: relative; transition: padding-left .18s ease, background .18s ease; border-radius: 3px; }
    .pp-toc li::before { content: counter(toc, decimal-leading-zero); color: var(--dimmer); margin-right: 14px; font-size: 12px; font-family: 'Source Code Pro', monospace; transition: color .18s ease; }
    .pp-toc li:hover { padding-left: 10px; background: var(--card); }
    .pp-toc li:hover::before { color: var(--a3); }
    .pp-toc li::after { content: ''; position: absolute; right: 12px; top: 50%; width: 0; height: 0; border-left: 5px solid var(--a1); border-top: 4px solid transparent; border-bottom: 4px solid transparent; opacity: 0; transform: translateY(-50%) translateX(-4px); transition: opacity .18s ease, transform .18s ease; }
    .pp-toc li:hover::after { opacity: 1; transform: translateY(-50%) translateX(0); }
    .pp-toc a { color: var(--tx); font-size: 13px; text-decoration: none; font-family: 'Source Code Pro', monospace; transition: color .18s ease; }
    .pp-toc a:hover { color: var(--a1); }
    /* headings */
    .pp-article h2 { font-size: 22px; font-weight: 700; color: var(--head); margin: 56px 0 20px; padding-bottom: 8px; border-bottom: 1px solid var(--bd); scroll-margin-top: 30px; line-height: 1.3; }
    .pp-h2 { font-size: 22px; font-weight: 700; color: var(--head); margin: 56px 0 20px; padding-bottom: 8px; border-bottom: 1px solid var(--bd); scroll-margin-top: 30px; line-height: 1.3; }
    .pp-h3 { font-size: 17px; font-weight: 600; color: var(--a1); margin: 36px 0 14px; line-height: 1.3; font-family: 'Source Code Pro', monospace; }
    /* paragraphs */
    .pp-article p { margin-bottom: 20px; color: var(--tx); font-size: 15px; line-height: 1.85; }
    /* inline code */
    .pp-article code { background: var(--card); border: 1px solid var(--bd); border-radius: 3px; padding: 1px 6px; font-size: 13px; color: var(--a2); font-family: 'Source Code Pro', monospace; }
    /* colors */
    .c-pink   { color: var(--a3) !important; font-weight: 600; }
    .c-cyan   { color: var(--a2) !important; font-weight: 600; }
    .c-green  { color: var(--a1) !important; font-weight: 600; }
    .c-orange { color: var(--a4) !important; font-weight: 600; }
    .c-light  { color: var(--head) !important; font-weight: 600; }
    /* code blocks */
    .pp-code { background: var(--bg2); border: 1px solid var(--bd); border-radius: 6px; margin: 20px 0; overflow: hidden; display: block; }
    .pp-code-head { background: var(--card); border-bottom: 1px solid var(--bd); padding: 7px 14px; display: flex; align-items: center; gap: 10px; }
    .pp-code-dots { display: flex; gap: 5px; flex-shrink: 0; }
    .pp-code-dot { width: 7px; height: 7px; border-radius: 50%; }
    .pp-code-dot:nth-child(1) { background: var(--dot1); }
    .pp-code-dot:nth-child(2) { background: var(--dot2); }
    .pp-code-dot:nth-child(3) { background: var(--dot3); }
    .pp-code-lang { color: var(--a3); font-size: 11px; flex: 1; }
    .pp-code-copy { color: var(--a3); font-size: 9px; border: 1px solid var(--bd); border-radius: 3px; padding: 2px 8px; background: none; cursor: pointer; margin-left: auto; transition: all .2s; font-family: 'Source Code Pro', monospace; }
    .pp-code-copy:hover { color: var(--a1); border-color: var(--a1); }
    .pp-code-body { padding: 16px 18px; overflow-x: auto; display: block; }
    .pp-code-body pre { font-size: 13px; line-height: 1.75; color: var(--head); white-space: pre; margin: 0; padding: 0; background: transparent; display: block; font-family: 'Source Code Pro', monospace; }
    /* note */
    .pp-note { background: var(--page); border-left: 3px solid var(--a4); padding: 14px 18px; margin: 20px 0; font-size: 13px; color: var(--dim); border-radius: 0 6px 6px 0; }
    .pp-note strong { color: var(--a4); }
    /* next post */
    .pp-next { margin-top: 60px; padding-top: 30px; border-top: 1px solid var(--bd); }
    .pp-next-label { color: var(--dimmer); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; }
    .pp-next-title { color: var(--a1); font-size: 15px; font-weight: 600; transition: color .18s ease; }
    .pp-next a { display: block; text-decoration: none; }
    .pp-next a:hover .pp-next-title { color: var(--a3); }
    .pp-next a:hover .pp-next-label { color: var(--a3); }
    /* markdown prose overrides */
    .pp-article ul, .pp-article ol { padding-left: 1.5rem; margin-bottom: 1.2rem; color: var(--tx); }
    .pp-article li { margin-bottom: 0.4rem; }
    .pp-article strong { color: var(--head); font-weight: 600; }
    .pp-article a { color: var(--a1); }
    .pp-article blockquote { border-left: 3px solid var(--a4); padding: 14px 18px; background: var(--page); border-radius: 0 6px 6px 0; margin: 1.5rem 0; color: var(--dim); font-size: 13px; }
    .pp-article pre { background: var(--bg2); border: 1px solid var(--bd); border-radius: 6px; padding: 16px 18px; overflow-x: auto; margin: 20px 0; }
    .pp-article pre code { background: none; border: none; padding: 0; color: var(--head); font-size: 13px; }
    /* RHCSA EX200 series additions (.pp-h3 skipped — already defined above) — recolored to site theme */
    .pp-series-badge { display:inline-block; font-family:'JetBrains Mono',monospace; font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; color:var(--a3); border:1px solid var(--bd); background:var(--card); border-radius:6px; padding:.35rem .7rem; margin:0 0 1.2rem; }
    .pp-tags { display:flex; flex-wrap:wrap; gap:.4rem; margin:0 0 2rem; }
    .pp-tag { font-family:'JetBrains Mono',monospace; font-size:.72rem; color:var(--a2); background:var(--card); border:1px solid var(--bd); border-radius:4px; padding:.2rem .5rem; }
    .pp-brief { border:1px solid var(--bd); border-left:3px solid var(--a2); background:color-mix(in srgb, var(--a2) 5%, transparent); border-radius:8px; padding:.4rem 1.2rem; margin:1.4rem 0 2rem; }
    .pp-brief p { margin:.55rem 0; }
    .pp-part { font-family:'JetBrains Mono',monospace; font-weight:700; font-size:1rem; letter-spacing:.06em; text-transform:uppercase; color:var(--bg2); background:var(--a3); border-radius:8px; padding:.75rem 1.1rem; margin:3.2rem 0 1.2rem; scroll-margin-top:1rem; }
    .pp-part small { display:block; font-size:.7rem; font-weight:500; text-transform:none; letter-spacing:0; opacity:.85; margin-top:.2rem; }
    .pp-deepdive { border:1px solid var(--bd); border-left:3px solid var(--a2); background:color-mix(in srgb, var(--a2) 4%, transparent); border-radius:6px; padding:.4rem 1.2rem 1rem; margin:1rem 0 1.4rem; }
    .pp-deepdive-label { font-family:'JetBrains Mono',monospace; color:var(--a2); font-size:.74rem; text-transform:uppercase; letter-spacing:.04em; margin:.7rem 0 .2rem; }
    .pp-exam-task { border:1px solid var(--bd); border-radius:8px; padding:.8rem 1.2rem; margin:1rem 0; background:var(--bg2); }
    .pp-exam-task h3 { margin-top:.3rem; }
    .pp-domain { display:inline-block; font-family:'JetBrains Mono',monospace; font-size:.7rem; color:var(--a2); background:var(--card); border:1px solid var(--bd); border-radius:4px; padding:.12rem .5rem; margin:.2rem 0 .8rem; }
    .pp-step { font-family:'JetBrains Mono',monospace; font-size:.9rem; color:var(--a3); margin:1.4rem 0 .3rem; }
    .pp-table { width:100%; border-collapse:collapse; margin:1rem 0 1.5rem; font-size:.82rem; }
    .pp-table th, .pp-table td { border:1px solid var(--bd); padding:.45rem .65rem; text-align:left; vertical-align:top; }
    .pp-table th { background:var(--card); color:var(--a2); font-family:'JetBrains Mono',monospace; }
  </style>
</head>
<body>
  <Nav />
  <article class="pp-article">
    <slot />
  </article>
  <Footer />
</body>
</html>
