---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  readTime?: number;
  tags?: string[];
}

const { title, description, date, category, readTime = 5, tags = [] } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' });
const isoDate = date.toISOString().slice(0, 10);
const bandTags = [category, ...tags.filter(t => t !== category)].slice(0, 3);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — projectpattie;</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--tx); font-family: 'JetBrains Mono', 'Source Code Pro', monospace; font-size: 15px; line-height: 1.85; -webkit-font-smoothing: antialiased; }
    .pp-article { max-width: 740px; margin: 0 auto; padding: 60px 24px 100px; }
    .pp-bandtags, .pp-meta, .pp-title, .pp-subtitle { background: var(--pom); box-shadow: 0 0 0 100vmax var(--pom); clip-path: inset(0 -100vmax); }
    .pp-article { padding-top: 0 !important; }
    .pp-bandtags { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 30px 0 10px; margin: 0; }
    .pp-bandtags ~ .pp-tags, .pp-bandtags ~ .pp-meta { display: none; }
    .pp-band-date { color: var(--on-pom-dim); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; align-self: center; margin-left: 4px; }
    .pp-meta { color: var(--on-pom-dim); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; margin: 0; padding: 30px 0 6px; }
    .pp-bandtags + .pp-meta { padding-top: 10px; }
    .pp-meta span { color: var(--lime); }
    .pp-title { font-size: clamp(24px, 3.6vw, 32px); font-weight: 700; color: var(--on-pom); line-height: 1.2; margin: 0; padding: 30px 0 12px; }
    .pp-meta + .pp-title, .pp-bandtags + .pp-title, .pp-bandtags ~ .pp-title { padding-top: 6px; }
    .pp-meta, .pp-title, .pp-subtitle { margin-top: -1px !important; border-top: 1px solid var(--pom); }
    .pp-title em { color: var(--lime); font-style: normal; }
    .pp-subtitle { color: var(--on-pom-dim); font-size: 15px; line-height: 1.7; margin: 0 0 48px; padding: 0 0 32px; }
    /* series nav */
    .pp-series { background: var(--calamine); border: 0; border-radius: 8px; padding: 20px 24px; margin-bottom: 30px; }
    .pp-series, .pp-series li, .pp-series li a, .pp-series li::before { color: var(--on-calamine) !important; }
    .pp-series li.active::after { color: var(--pom) !important; font-weight: 700; }
    .pp-series-label { color: var(--pom) !important; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px; font-weight: 600; }
    .pp-series ol { list-style: none; padding: 0; counter-reset: series; }
    .pp-series li { counter-increment: series; margin-bottom: 6px; font-size: 13px; color: var(--dimmer); }
    .pp-series li::before { content: "Part " counter(series) ":"; color: var(--dimmer); margin-right: 8px; font-size: 12px; }
    .pp-series li.active { color: var(--head); }
    .pp-series li.active::before { color: var(--a1); }
    .pp-series li.active::after { content: " ← you are here"; color: var(--a1); font-size: 11px; }
    .pp-series li a { color: var(--tx); text-decoration: none; transition: color .18s ease; }
    .pp-series li a:hover { color: var(--a1); text-decoration: none; }
    /* toc — styled like a terminal card with mac dots */
    .pp-toc { background: var(--bg2); border: 1px solid var(--bd); border-radius: 6px; padding: 0; margin: 30px 0 50px; overflow: hidden; }
    .pp-toc-label { background: var(--card); border-bottom: 1px solid var(--bd); padding: 11px 18px 11px 56px; margin: 0; color: var(--on-sea); font-weight: 700; background: var(--sea) !important; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; font-family: 'Source Code Pro', monospace; position: relative; }
    .pp-toc-label::before { content: ''; position: absolute; top: 50%; left: 18px; width: 7px; height: 7px; border-radius: 50%; background: var(--dot1); transform: translateY(-50%); box-shadow: 12px 0 0 var(--dot2), 24px 0 0 var(--dot3); }
    .pp-toc-label span { color: var(--on-sea); }
    .pp-toc { background: var(--cobalt) !important; border: 0 !important; }
    .pp-toc ol { padding: 18px 22px; margin: 0; counter-reset: toc; list-style: none; }
    .pp-toc li { counter-increment: toc; margin: 0; padding: 5px 8px 5px 0; position: relative; transition: padding-left .18s ease, background .18s ease; border-radius: 3px; }
    .pp-toc li::before { content: counter(toc, decimal-leading-zero); color: var(--pom); font-weight: 700; margin-right: 14px; font-size: 12px; font-family: 'Source Code Pro', monospace; transition: color .18s ease; }
    .pp-toc li:hover { padding-left: 10px; background: var(--on-cobalt); }
    .pp-toc li:hover a { color: var(--cobalt); }
    .pp-toc li:hover::before { color: var(--lime); }
    .pp-toc li::after { content: ''; position: absolute; right: 12px; top: 50%; width: 0; height: 0; border-left: 5px solid var(--lime); border-top: 4px solid transparent; border-bottom: 4px solid transparent; opacity: 0; transform: translateY(-50%) translateX(-4px); transition: opacity .18s ease, transform .18s ease; }
    .pp-toc li:hover::after { opacity: 1; transform: translateY(-50%) translateX(0); }
    .pp-toc a { color: var(--on-cobalt); font-weight: 500; font-size: 13px; text-decoration: none; font-family: 'Source Code Pro', monospace; transition: color .18s ease; }
    .pp-toc a:hover { color: var(--cobalt); text-decoration: none; }
    /* headings */
    .pp-article h2 { display: table; font-size: 22px; font-weight: 700; color: var(--on-lime); background: var(--lime); margin: 56px 0 20px; padding: 4px 14px; border-radius: 6px; scroll-margin-top: 30px; line-height: 1.3; }
    .pp-h2 { display: table; font-size: 22px; font-weight: 700; color: var(--on-lime); background: var(--lime); margin: 56px 0 20px; padding: 4px 14px; border-radius: 6px; scroll-margin-top: 30px; line-height: 1.3; }
    .pp-h3 { display: table; font-size: 17px; font-weight: 700; color: var(--on-calamine); background: var(--calamine); padding: 2px 12px; border-radius: 5px; margin: 36px 0 14px; line-height: 1.3; font-family: 'Source Code Pro', monospace; }
    /* paragraphs */
    .pp-article p { margin-bottom: 20px; color: var(--tx); font-size: 15px; line-height: 1.85; }
    /* inline code */
    .pp-article code { background: var(--lime); border: 1px solid var(--lime); border-radius: 3px; padding: 1px 6px; font-size: 13px; color: var(--on-lime); font-weight: 500; font-family: 'Source Code Pro', monospace; }
    /* markdown-style heading markers */
    .pp-article h2::before, .pp-h2::before { content: '# '; }
    .pp-article h3::before, .pp-h3::before { content: '## '; }
    /* code inside a lime heading keeps the heading colours */
    .pp-article h2 code, .pp-h2 code { background: var(--on-lime); color: var(--lime); border-color: var(--on-lime); }
    /* headings cycle through the palette so a post never reads as one colour */
    .pp-article h2:nth-of-type(5n+2), .pp-h2:nth-of-type(5n+2) { background: var(--calamine); color: var(--on-calamine); }
    .pp-article h2:nth-of-type(5n+3), .pp-h2:nth-of-type(5n+3) { background: var(--pom); color: var(--on-pom); }
    .pp-article h2:nth-of-type(5n+4), .pp-h2:nth-of-type(5n+4) { background: var(--cobalt); color: var(--on-cobalt); }
    .pp-article h2:nth-of-type(5n+5), .pp-h2:nth-of-type(5n+5) { background: var(--sea); color: var(--on-sea); }
    .pp-article h3:nth-of-type(4n+2), .pp-h3:nth-of-type(4n+2) { background: var(--lime); color: var(--on-lime); }
    .pp-article h3:nth-of-type(4n+3), .pp-h3:nth-of-type(4n+3) { background: var(--cobalt); color: var(--on-cobalt); }
    .pp-article h3:nth-of-type(4n+4), .pp-h3:nth-of-type(4n+4) { background: var(--sea); color: var(--on-sea); }
    .pp-article li code { background: var(--calamine); border-color: var(--calamine); color: var(--on-calamine); }
    .pp-article p strong, .pp-article li strong { color: var(--lime); }
    .pp-article p em, .pp-article li em { color: var(--calamine); font-style: normal; font-weight: 600; }
    .pp-bandtags .pp-tag:nth-child(4n+4) { background: var(--sea); color: var(--on-sea); }
    .pp-bandtags .pp-tag { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; padding: 3px 10px; border-radius: 4px; }
    .pp-bandtags .pp-tag:nth-child(4n+1) { background: var(--lime); color: var(--on-lime); }
    /* tags cycle through the palette */
    .pp-tag:nth-child(4n+2) { background: var(--calamine); color: var(--on-calamine); }
    .pp-tag:nth-child(4n+3) { background: var(--cobalt); color: var(--on-cobalt); }
    .pp-tag:nth-child(4n+4) { background: var(--pom); color: var(--on-pom); }
    .pp-article td { background: var(--card); }
    .pp-article blockquote strong, .pp-article blockquote a { color: var(--on-cobalt); }
    .pp-article blockquote code { background: var(--on-cobalt); color: var(--cobalt); border-color: var(--on-cobalt); }
    /* colors */
    .c-pink   { color: var(--a3) !important; font-weight: 600; }
    .c-cyan   { color: var(--a2) !important; font-weight: 600; }
    .c-green  { color: var(--a1) !important; font-weight: 600; }
    .c-orange { color: var(--a4) !important; font-weight: 600; }
    .c-light  { color: var(--head) !important; font-weight: 600; }
    /* code blocks */
    .pp-code { background: var(--slate); border: 0; border-radius: 6px; margin: 20px 0; overflow: hidden; display: block; }
    .pp-code-head { background: var(--greenblue); border-bottom: 0; padding: 7px 14px; display: flex; align-items: center; gap: 10px; }
    .pp-code-dots { display: flex; gap: 5px; flex-shrink: 0; }
    .pp-code-dot { width: 11px; height: 11px; border-radius: 50%; }
    .pp-code-dot:nth-child(1) { background: var(--dot1); }
    .pp-code-dot:nth-child(2) { background: var(--dot2); }
    .pp-code-dot:nth-child(3) { background: var(--dot3); }
    .pp-code-lang { margin-left: auto; color: var(--cobalt); background: var(--slate); font-size: 11px; font-weight: 700; padding: 0 7px; border-radius: 3px; flex: 0 0 auto; }
    .pp-code-copy { color: var(--on-lime); font-size: 9px; font-weight: 700; border: 1px solid var(--lime); border-radius: 3px; padding: 2px 8px; background: var(--lime); cursor: pointer; margin-left: auto; transition: all .2s; font-family: 'Source Code Pro', monospace; }
    .pp-code-copy:hover { color: var(--lime); background: var(--slate); border-color: var(--slate); }
    .pp-code-body { padding: 16px 18px; overflow-x: auto; display: block; }
    .pp-code-body pre { font-size: 13px; line-height: 1.75; color: var(--head); white-space: pre; margin: 0; padding: 0; background: transparent; display: block; font-family: 'Source Code Pro', monospace; }
    /* note */
    .pp-note { background: var(--note); border-left: 3px solid var(--pom); padding: 14px 18px; margin: 20px 0; font-size: 13px; color: var(--on-note); border-radius: 0 6px 6px 0; }
    .pp-note strong { color: var(--on-pom); background: var(--pom); padding: 0 6px; border-radius: 3px; }
    /* next post */
    .pp-next { margin-top: 60px; padding: 22px 26px; border: 0; border-radius: 10px; background: var(--sea); }
    .pp-next-label { color: var(--on-sea); font-weight: 700; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; }
    .pp-next-title { color: var(--on-sea); font-size: 15px; font-weight: 600; transition: color .18s ease; }
    .pp-next a { display: block; text-decoration: none; }
    .pp-next a:hover .pp-next-title { color: var(--pom); }
    .pp-next a:hover .pp-next-label { color: var(--pom); }
    /* markdown prose overrides */
    .pp-article ul, .pp-article ol { padding-left: 1.5rem; margin-bottom: 1.2rem; color: var(--tx); }
    .pp-article li::marker { color: var(--a3); font-weight: 700; }
    .pp-article li { margin-bottom: 0.4rem; }
    .pp-article strong { color: var(--head); font-weight: 600; }
    .pp-article a { color: var(--a1); text-decoration: underline; text-decoration-color: var(--sea); text-underline-offset: 3px; }
    .pp-article blockquote { border-left: 5px solid var(--sea); padding: 14px 18px; background: var(--cobalt); border-radius: 0 8px 8px 0; margin: 1.5rem 0; color: var(--on-cobalt); font-size: 13px; }
    .pp-article pre { background: var(--bg2); border: 1px solid var(--bd); border-radius: 6px; padding: 16px 18px; overflow-x: auto; margin: 20px 0; }
    .pp-article pre.astro-code { background: linear-gradient(var(--greenblue) 0 38px, var(--slate) 38px) !important; border: 0; position: relative; padding-top: 54px; border-radius: 8px; }
    .pp-article pre.astro-code::before { content: attr(data-language); position: absolute; top: 6px; right: 10px; background: var(--slate); color: var(--cobalt); font-size: 12px; font-weight: 700; padding: 1px 10px; border-radius: 5px; text-transform: lowercase; }
    .pp-article pre.astro-code[data-language="plaintext"]::before { content: 'text'; }
    .pp-article pre.astro-code::after { content: ''; position: absolute; top: 14px; left: 18px; width: 11px; height: 11px; border-radius: 50%; background: var(--dot1); box-shadow: 18px 0 0 var(--dot2), 36px 0 0 var(--dot3); }
    .pp-article pre code { background: none; border: none; padding: 0; color: var(--head); font-size: 13px; }
    /* RHCSA EX200 series additions (.pp-h3 skipped — already defined above) — recolored to site theme */
    .pp-series-badge { display:inline-block; font-family:'JetBrains Mono',monospace; font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; color:var(--a3); border:1px solid var(--bd); background:var(--card); border-radius:6px; padding:.35rem .7rem; margin:0 0 1.2rem; }
    .pp-tags { display:flex; flex-wrap:wrap; gap:.4rem; margin:0 0 2rem; }
    .pp-tag { font-family:'JetBrains Mono',monospace; font-size:.72rem; font-weight:700; color:var(--on-lime); background:var(--lime); border:0; border-radius:4px; padding:.2rem .5rem; }
    .pp-brief { border:1px solid var(--bd); border-left:3px solid var(--a2); background:color-mix(in srgb, var(--a2) 5%, transparent); border-radius:8px; padding:.4rem 1.2rem; margin:1.4rem 0 2rem; }
    .pp-brief p { margin:.55rem 0; }
    .pp-part { font-family:'JetBrains Mono',monospace; font-weight:700; font-size:1rem; letter-spacing:.06em; text-transform:uppercase; color:var(--bg2); background:var(--a3); border-radius:8px; padding:.75rem 1.1rem; margin:3.2rem 0 1.2rem; scroll-margin-top:1rem; }
    .pp-part small { display:block; font-size:.7rem; font-weight:500; text-transform:none; letter-spacing:0; opacity:.85; margin-top:.2rem; }
    .pp-deepdive { border:1px solid var(--bd); border-left:3px solid var(--a2); background:color-mix(in srgb, var(--a2) 4%, transparent); border-radius:6px; padding:.4rem 1.2rem 1rem; margin:1rem 0 1.4rem; }
    .pp-deepdive-label { font-family:'JetBrains Mono',monospace; color:var(--a2); font-size:.74rem; text-transform:uppercase; letter-spacing:.04em; margin:.7rem 0 .2rem; }
    .pp-exam-task { border:1px solid var(--bd); border-radius:8px; padding:.8rem 1.2rem; margin:1rem 0; background:var(--bg2); }
    .pp-exam-task h3 { margin-top:.3rem; }
    .pp-domain { display:inline-block; font-family:'JetBrains Mono',monospace; font-size:.7rem; color:var(--a2); background:var(--card); border:1px solid var(--bd); border-radius:4px; padding:.12rem .5rem; margin:.2rem 0 .8rem; }
    .pp-step { font-family:'JetBrains Mono',monospace; font-size:.9rem; color:var(--a3); margin:1.4rem 0 .3rem; }
    .pp-table { width:100%; border-collapse:collapse; margin:1rem 0 1.5rem; font-size:.82rem; }
    .pp-table th, .pp-table td { border:1px solid var(--bd); padding:.45rem .65rem; text-align:left; vertical-align:top; }
    .pp-table th { background:var(--greenblue); color:var(--on-greenblue); font-family:'JetBrains Mono',monospace; }
    /* bare-markdown elements: h3, tables, hr, so plain .md posts match pp-* posts */
    .pp-article h3 { display: table; font-size: 17px; font-weight: 700; color: var(--on-calamine); background: var(--calamine); padding: 2px 12px; border-radius: 5px; margin: 36px 0 14px; line-height: 1.3; font-family: 'Source Code Pro', monospace; }
    .pp-article table { width: 100%; border-collapse: collapse; margin: 1rem 0 1.5rem; font-size: .82rem; display: block; overflow-x: auto; }
    .pp-article th, .pp-article td { border: 1px solid var(--bd); padding: .45rem .65rem; text-align: left; vertical-align: top; }
    .pp-article th { background: var(--greenblue); color: var(--on-greenblue); font-family: 'JetBrains Mono', monospace; }
    .pp-article hr { border: 0; border-top: 3px dashed var(--sea); margin: 48px 0; }
  </style>
</head>
<body>
  <Nav />
  <article class="pp-article">
    <div class="pp-bandtags">{bandTags.map(t => <span class="pp-tag">{t}</span>)}<span class="pp-band-date">{isoDate} · {readTime} min read</span></div>
    <slot />
  </article>
  <Footer />
</body>
</html>
