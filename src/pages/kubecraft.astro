---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'kubecraft homelab';
---

<BaseLayout
  title={`${title} — projectpattie;`}
  description="A from-scratch Kubernetes build log. Not published yet."
>
  <div class="ph">
    <div class="hbg"></div>
    <div class="ph-in">
      <div class="ph-pl"><span class="u">root@pattie</span> ~ <span class="p">/kubecraft</span></div>
      <h1 class="ph-t">{title}</h1>
      <p class="ph-s">// kubernetes, from scratch</p>
    </div>
  </div>

  <div class="soon">
    <div class="panel">
      <div class="panel-h">
        <div class="panel-dot"></div>
        <span class="panel-tag">homelab</span>
        <span class="panel-path">~/kubecraft</span>
      </div>
      <div class="panel-b">
        <div class="sh">
          <span class="pr">$</span> ls ~/kubecraft
          <span class="ln"><span class="b">›</span> build in progress</span>
          <span class="ln"><span class="b">›</span> first logs landing soon</span>
        </div>
        <p class="lead">Nothing to read here yet.</p>
        <p>The kubecraft homelab is a from-scratch Kubernetes build — what I ran, what
        confused me, and what broke. When there is something worth publishing, it lands
        here.</p>
        <div class="ft">
          <a href="/brasil/demo" class="lk">the brasil homelab →</a>
          <a href="/category/devops" class="lk alt">devops writing →</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}

  .ph{background:var(--page);border-bottom:1px solid var(--bd);position:relative;overflow:hidden}
  .hbg{position:absolute;inset:0;background-image:linear-gradient(color-mix(in srgb,var(--a1) 4%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--a1) 4%,transparent) 1px,transparent 1px);background-size:44px 44px;pointer-events:none}
  .ph-in{max-width:820px;margin:0 auto;padding:46px 24px 34px;position:relative}
  .ph-pl{color:var(--dim);font-size:12px;margin-bottom:11px}
  .ph-pl .u{color:var(--a1)}
  .ph-pl .p{color:var(--a2)}
  .ph-t{font-size:clamp(26px,4.5vw,34px);font-weight:700;letter-spacing:-.02em;margin-bottom:6px;color:var(--head)}
  .ph-s{font-size:12.5px;color:var(--dim);margin-bottom:0}

  .soon{max-width:820px;margin:0 auto;padding:34px 24px 80px}
  .panel{--ac:var(--a2);background:var(--card);border:1px solid var(--bd);border-radius:7px;overflow:hidden;position:relative}
  .panel::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--ac)}
  .panel-h{background:var(--bg2);border-bottom:1px solid var(--bd);padding:8px 15px;display:flex;align-items:center;gap:8px}
  .panel-dot{width:6px;height:6px;border-radius:50%;background:var(--ac);animation:pulse 2.4s ease-in-out infinite}
  .panel-tag{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ac)}
  .panel-path{margin-left:auto;font-size:9px;color:var(--dimmer)}
  .panel-b{padding:24px}

  .sh{background:var(--bg2);border:1px solid var(--bd);border-radius:5px;padding:13px 15px;margin-bottom:22px;font-size:11.5px;line-height:1.95}
  .sh .pr{color:var(--ac)}
  .sh .ln{color:var(--dim);display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .sh .ln .b{color:var(--dimmer)}

  .lead{font-size:16px;color:var(--head);margin-bottom:14px}
  .panel-b p{font-size:14px;line-height:1.9;color:var(--tx);margin-bottom:16px}

  .ft{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
  .lk{display:inline-flex;gap:7px;color:var(--a1);border:1px solid var(--a1);border-radius:4px;padding:9px 15px;font-size:12px;text-decoration:none}
  .lk.alt{color:var(--dim);border-color:var(--bd2)}
  .lk.alt:hover{color:var(--head);border-color:var(--dim)}

  @media(max-width:900px){
    .ph-in,.soon{padding-left:18px;padding-right:18px}
  }
</style>
