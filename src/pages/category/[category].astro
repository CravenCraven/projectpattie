---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categories = ['sysadmin','cybersecurity','hackerbox','tryhackme','devops','thoughts'];
  return categories.map(category => ({ params: { category } }));
}

const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

const { category } = Astro.params;
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.filter(p => p.data.category === category);

// Bucket posts: those that belong to a series get grouped, others are standalone.
type Post = (typeof posts)[number];
const seriesGroups = new Map<string, Post[]>();
const standalone: Post[] = [];

for (const post of posts) {
  const s = post.data.series;
  if (s) {
    if (!seriesGroups.has(s)) seriesGroups.set(s, []);
    seriesGroups.get(s)!.push(post);
  } else {
    standalone.push(post);
  }
}

// Sort each series by seriesOrder (ascending — readers start at Part 1).
for (const list of seriesGroups.values()) {
  list.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
}

// Sort standalone by date (newest first).
standalone.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Order series by their newest part's date — newest series first.
const seriesEntries = Array.from(seriesGroups.entries())
  .map(([name, list]) => ({
    name,
    list,
    newestDate: Math.max(...list.map(p => p.data.date.valueOf())),
  }))
  .sort((a, b) => b.newestDate - a.newestDate);

const totalPostCount = posts.length;
---

<BaseLayout title={`${category} — projectpattie;`}>
  <div style="max-width:900px; margin:0 auto; padding:60px 24px 100px;">
    <div style="font-size:12px; color:var(--dimmer); margin-bottom:12px;">// category</div>
    <h1 style="font-size:28px; margin-bottom:40px;">{category}</h1>

    {totalPostCount === 0 ? (
      <div style="border:1px solid var(--bd); border-radius:6px; padding:32px; text-align:center; color:var(--dimmer); font-size:13px;">
        coming soon — check back shortly.
      </div>
    ) : (
      <div style="display:flex; flex-direction:column; gap:36px;">

        {seriesEntries.map(({ name, list }) => (
          <a href={`/series/${slugify(name)}`} class="cat-series-card">
            <div class="cat-section-label">// <span>series</span> {name} <span class="cat-section-count">{list.length} parts</span></div>
            <div class="cat-series-titles">
              {list.slice(0, 3).map(post => (
                <div class="cat-series-line">
                  <span class="cat-series-order">{String(post.data.seriesOrder ?? 0).padStart(2, '0')}</span>
                  {post.data.title}
                </div>
              ))}
              {list.length > 3 && <div class="cat-series-line cat-series-more">+ {list.length - 3} more</div>}
            </div>
            <div class="cat-series-cta">open the series →</div>
          </a>
        ))}

        {standalone.length > 0 && (
          <section>
            {seriesEntries.length > 0 && (
              <div class="cat-section-label">// <span>standalone</span> posts</div>
            )}
            <div class="cat-cards">
              {standalone.map(post => (
                <PostCard
                  title={post.data.title}
                  description={post.data.description}
                  slug={post.slug}
                  date={post.data.date}
                  category={post.data.category}
                  readTime={post.data.readTime}
                />
              ))}
            </div>
          </section>
        )}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .cat-section-label {
    color: var(--a3);
    font-size: 11px;
    letter-spacing: .15em;
    text-transform: uppercase;
    margin: 0 0 16px;
    font-family: 'Source Code Pro', monospace;
  }
  .cat-section-label span { color: var(--dimmer); }
  .cat-section-count {
    color: var(--dimmer);
    margin-left: 8px;
    font-size: 10px;
    letter-spacing: .12em;
  }
  .cat-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cat-series-card {
    display: block;
    text-decoration: none;
    border: 1px solid var(--bd);
    border-left: 3px solid var(--a3);
    border-radius: 6px;
    background: var(--card);
    padding: 18px 20px;
    transition: border-color .2s, background .2s;
  }
  .cat-series-card:hover {
    border-color: var(--a3);
    background: var(--bd);
    text-decoration: none;
  }
  .cat-series-card .cat-section-label { margin-bottom: 14px; }
  .cat-series-titles {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 14px;
  }
  .cat-series-line {
    color: var(--tx);
    font-size: 13px;
    font-family: 'Source Code Pro', monospace;
  }
  .cat-series-order {
    color: var(--a3);
    margin-right: 10px;
    font-size: 12px;
  }
  .cat-series-more { color: var(--dimmer); }
  .cat-series-cta {
    color: var(--a1);
    font-size: 12px;
    letter-spacing: .08em;
    font-family: 'Source Code Pro', monospace;
  }
</style>
