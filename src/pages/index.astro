---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const MAX_POSTS = 4;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, MAX_POSTS);

// Brasil lists real content when there is any; kubecraft is not built yet.
const brasilTiles = (await getCollection('demo'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2)
  .map(t => `${t.data.title.toLowerCase()} — ${t.data.sub.toLowerCase()}`);

const PENDING = ['build in progress', 'first logs landing soon'];

const labs = [
  {
    tone: 'one',
    path: '~/brasil',
    title: 'brasil',
    sub: 'bare metal · k3s · gitops',
    blurb: 'bare-metal kubernetes on a mac cluster. k3s, flux gitops, self-hosted apps, and everything that breaks along the way.',
    lines: brasilTiles.length ? brasilTiles : PENDING,
    href: '/brasil/demo',
  },
  {
    tone: 'two',
    path: '~/kubecraft',
    title: 'kubecraft',
    sub: 'kubernetes · from scratch',
    blurb: 'the kubernetes build log. what i ran, what confused me, what broke, and how confident i actually am about each piece of it.',
    lines: PENDING,
    href: '/kubecraft',
  },
];

// Terminal slides. Rendered server-side so the scoped styles apply and the
// first frame is visible without JS; the script only cycles the hide class.
const termSlides = [
  [[['g', '$'], ['c', ' whoami']], [['d', 'craven']], [['d', 'sysadmin → devops']], [['d', 'still paranoid about security']]],
  [[['g', '$'], ['c', ' cat'], ['d', ' ~/.philosophy']], [['m', 'break things on purpose']], [['o', 'break them better']], [['o', 'next time']]],
  [[['g', '$'], ['c', ' ls'], ['d', ' -la /labs']], [['o', 'brasil-homelab/']], [['m', 'kubecraft-homelab/']], [['c', 'mac-cluster/']]],
  [[['g', '$'], ['c', ' tail'], ['d', ' /var/log/learning']], [['g', '[OK]'], ['d', ' writeups shipped']], [['o', '[WARN]'], ['d', ' k3s node flapping']], [['g', '[OK]'], ['d', ' still curious']]],
];

const quotes = [
  ['The quieter you become, the more you are able to hear.', 'Kali Linux MOTD'],
  ['Talk is cheap. Show me the code.', 'Linus Torvalds'],
  ['Amateurs hack systems, professionals hack people.', 'Bruce Schneier'],
  ['There are two ways to write error-free programs; only the third one works.', 'Alan J. Perlis'],
  ["Security is always excessive until it's not enough.", 'Robbie Sinclair'],
  ['In theory, theory and practice are the same. In practice, they are not.', 'Yogi Berra'],
  ['Programs must be written for people to read, and only incidentally for machines to execute.', 'Harold Abelson'],
  ["The most likely way for the world to be destroyed is by accident. That's where we come in; we're computer professionals. We cause accidents.", 'Nathaniel Borenstein'],
  ['Weeks of coding can save you hours of planning.', 'Anonymous'],
  ["It's not a bug. It's an undocumented feature.", 'Anonymous'],
  ['There are only two hard things in computer science: cache invalidation and naming things.', 'Phil Karlton'],
  ['Simplicity is prerequisite for reliability.', 'Edsger W. Dijkstra'],
  ['Given enough eyeballs, all bugs are shallow.', "Linus's Law"],
  ['The best way to predict the future is to implement it.', 'Alan Kay'],
];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
---

<BaseLayout>
  <div class="hero">
    <div class="hbg"></div><div class="hsc"></div>
    <div class="hin">
      <div class="hl">
        <div class="hpl">root@pattie <span class="t">~</span></div>
        <h1 class="hh">notes from the <span class="ac">terminal</span><span class="cur"></span></h1>
        <p class="hd">breaking things on purpose so production doesn't. kubernetes, homelab builds, ci/cd, and the security background to know why it matters.</p>
      </div>
      <div class="term">
        <div class="t-h">
          <div class="t-d d1"></div><div class="t-d d2"></div><div class="t-d d3"></div>
          <span class="t-t">session.sh</span>
        </div>
        <div class="t-b" id="ppTerm">
          {termSlides.map((slide, i) => (
            <div class={`t-s${i ? ' hide' : ''}`}>
              {slide.map(line => (
                <div>{line.map(([cls, text]) => <span class={cls}>{text}</span>)}</div>
              ))}
              <div><span class="g">$</span> <span class="tc"></span></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="wrap">
    <div class="sl">the homelabs</div>
    <div class="labs">
      {labs.map(lab => (
        <div class={`lab ${lab.tone}`}>
          <div class="lab-h">
            <div class="lab-dot"></div>
            <span class="lab-tag">homelab</span>
            <span class="lab-path">{lab.path}</span>
          </div>
          <div class="lab-b">
            <div class="lab-t">{lab.title} <span class="hl">homelab</span></div>
            <div class="lab-s">{lab.sub}</div>
            <p class="lab-d">{lab.blurb}</p>
            <div class="lab-sh">
              <span class="pr">$</span> ls {lab.path}
              {lab.lines.map(l => <span class="ln"><span class="b">›</span> {l}</span>)}
            </div>
            <a href={lab.href} class="lab-lk">view the build →</a>
          </div>
        </div>
      ))}
    </div>

    <div class="sl">latest transmissions</div>
    <div class="posts">
      {posts.map(post => (
        <a href={`/blog/${post.slug}/`} class="pc">
          <div class="pc-m">
            <span class="c">{post.data.category}</span> · {fmt(post.data.date)}
            {post.data.readTime && <> · {post.data.readTime} min</>}
          </div>
          <div class="pc-t">{post.data.title}</div>
          <p class="pc-d">{post.data.description}</p>
          <span class="pc-r">read more →</span>
        </a>
      ))}
    </div>

    <div class="q">
      <div class="q-h">
        <div class="q-d d1"></div><div class="q-d d2"></div><div class="q-d d3"></div>
        <span class="q-t">/dev/random</span>
      </div>
      <div class="q-b" id="ppQuotes">
        {quotes.map(([text, attr], i) => (
          <div class={`q-s${i ? ' hide' : ''}`}>
            <div class="q-x">"{text}"</div>
            <div class="q-a">— {attr}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function rotate(id: string, ms: number) {
    const box = document.getElementById(id);
    if (!box || box.children.length < 2) return;
    let i = 0;
    setInterval(() => {
      box.children[i].classList.add('hide');
      i = (i + 1) % box.children.length;
      box.children[i].classList.remove('hide');
    }, ms);
  }
  rotate('ppTerm', 3800);
  rotate('ppQuotes', 6000);
</script>

<style>
  @keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
  @keyframes scan{0%{top:-2px}100%{top:100%}}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}

  /* hero */
  .hero{background:var(--page);border-bottom:1px solid var(--bd);position:relative;overflow:hidden}
  .hbg{position:absolute;inset:0;background-image:linear-gradient(color-mix(in srgb,var(--a1) 4%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--a1) 4%,transparent) 1px,transparent 1px);background-size:44px 44px;pointer-events:none}
  .hsc{position:absolute;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--a2),transparent);animation:scan 7s linear infinite;opacity:.3}
  .hin{max-width:1080px;margin:0 auto;padding:50px 24px 46px;position:relative;display:flex;gap:36px;align-items:flex-start}
  .hl{flex:1;min-width:0}
  .hpl{color:var(--a1);font-size:12px;margin-bottom:14px}
  .hpl .t{color:var(--a3)}
  .hh{font-size:clamp(27px,4.6vw,40px);font-weight:700;line-height:1.25;margin-bottom:16px;letter-spacing:-.02em}
  .hh .ac{color:var(--a3)}
  .hh .cur{display:inline-block;width:11px;height:.82em;background:var(--a2);margin-left:5px;animation:blink 1.1s step-end infinite}
  .hd{color:var(--dim);font-size:14px;line-height:1.85;max-width:520px;margin-bottom:0}

  /* terminal panel */
  .term{width:290px;flex-shrink:0;background:var(--bg2);border:1px solid var(--bd2);border-radius:6px;overflow:hidden}
  .t-h{background:var(--card);border-bottom:1px solid var(--bd);padding:7px 12px;display:flex;align-items:center;gap:5px}
  .t-d{width:7px;height:7px;border-radius:50%}
  .t-t{color:var(--dimmer);font-size:9px;margin-left:7px}
  .t-b{padding:14px 15px;font-size:11.5px;line-height:2;position:relative;height:148px;overflow:hidden}
  .t-s{position:absolute;left:15px;right:15px;top:14px;transition:opacity .45s,transform .45s}
  .t-s.hide{opacity:0;transform:translateY(-9px)}
  .g{color:var(--a1)}.c{color:var(--a2)}.d{color:var(--dimmer)}.m{color:var(--a3)}.o{color:var(--a4)}
  .tc{display:inline-block;width:7px;height:12px;background:var(--a1);vertical-align:middle;animation:blink 1.1s step-end infinite}
  .d1{background:var(--dot1)}.d2{background:var(--dot2)}.d3{background:var(--dot3)}

  .wrap{max-width:1080px;margin:0 auto;padding:0 24px 72px}
  .sl{font-size:11px;letter-spacing:.16em;text-transform:uppercase;margin:44px 0 16px;display:flex;align-items:baseline;gap:9px;color:var(--a2)}
  .sl::before{content:'//';color:var(--dimmer)}

  /* homelab panels */
  .labs{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .lab{background:var(--card);border:1px solid var(--bd);border-radius:7px;overflow:hidden;display:flex;flex-direction:column;position:relative}
  .lab::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--ac)}
  .lab.one{--ac:var(--a1)}.lab.two{--ac:var(--a2)}
  .lab-h{background:var(--bg2);border-bottom:1px solid var(--bd);padding:8px 15px;display:flex;align-items:center;gap:8px}
  .lab-dot{width:6px;height:6px;border-radius:50%;background:var(--ac);animation:pulse 2.4s ease-in-out infinite}
  .lab-tag{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ac)}
  .lab-path{margin-left:auto;font-size:9px;color:var(--dimmer)}
  .lab-b{padding:22px;display:flex;flex-direction:column;flex:1}
  .lab-t{font-size:23px;font-weight:700;color:var(--head);line-height:1.2;margin-bottom:5px}
  .lab-t .hl{color:var(--ac)}
  .lab-s{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--dimmer);margin-bottom:14px}
  .lab-d{color:var(--dim);font-size:12.5px;line-height:1.75;margin-bottom:18px}
  .lab-sh{background:var(--bg2);border:1px solid var(--bd);border-radius:5px;padding:13px 15px;margin-bottom:18px;font-size:11.5px;line-height:1.95}
  .lab-sh .pr{color:var(--ac)}
  .lab-sh .ln{color:var(--dim);display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .lab-sh .ln .b{color:var(--dimmer)}
  .lab-lk{display:inline-flex;gap:7px;color:var(--ac);border:1px solid var(--ac);border-radius:4px;padding:9px 15px;font-size:12px;margin-top:auto;align-self:flex-start;text-decoration:none}

  /* post cards */
  .posts{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .pc{border:1px solid var(--bd);border-radius:7px;padding:22px;display:block;background:var(--card);text-decoration:none}
  .pc:hover{border-color:var(--a1);text-decoration:none}
  .pc-m{font-size:10px;color:var(--dimmer);letter-spacing:.1em;text-transform:uppercase;margin-bottom:11px}
  .pc-m .c{color:var(--a1)}
  .pc-t{font-size:17px;font-weight:700;color:var(--head);margin-bottom:9px;line-height:1.35}
  .pc-d{font-size:13px;color:var(--dim);line-height:1.7;margin-bottom:0}
  .pc-r{display:inline-block;margin-top:14px;font-size:12px;color:var(--a1)}

  /* quote rotator */
  .q{background:var(--card);border:1px solid var(--bd);border-radius:7px;overflow:hidden;margin-top:44px}
  .q-h{background:var(--bg2);border-bottom:1px solid var(--bd);padding:7px 15px;display:flex;align-items:center;gap:5px}
  .q-d{width:7px;height:7px;border-radius:50%}
  .q-t{color:var(--dimmer);font-size:9px;margin-left:7px}
  .q-b{padding:20px;position:relative;min-height:104px}
  .q-s{position:absolute;left:20px;right:20px;top:20px;transition:opacity .55s,transform .55s}
  .q-s.hide{opacity:0;transform:translateY(-8px)}
  .q-x{color:var(--head);font-size:13.5px;line-height:1.65;font-style:italic;margin-bottom:7px}
  .q-a{color:var(--a4);font-size:11px}

  @media(max-width:900px){
    .hin{flex-direction:column;gap:26px;padding:40px 18px 36px}
    .term{width:100%}
    .labs,.posts{grid-template-columns:1fr}
    .wrap{padding-left:18px;padding-right:18px}
  }
</style>
