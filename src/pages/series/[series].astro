---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const slugify = (s: string) =>
    s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const seriesNames = [
    ...new Set(posts.map(p => p.data.series).filter((s): s is string => !!s)),
  ];
  return seriesNames.map(name => ({
    params: { series: slugify(name) },
    props: { seriesName: name },
  }));
}

const { seriesName } = Astro.props as { seriesName: string };

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter(p => p.data.series === seriesName)
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));

// Every post in a series shares one category; use the first as the back-link.
const category = posts[0]?.data.category ?? 'sysadmin';
---

<BaseLayout title={`${seriesName} — projectpattie;`}>
  <div style="max-width:900px; margin:0 auto; padding:60px 24px 100px;">
    <header class="list-band">
      <div class="list-kicker"><a href={`/category/${category}`}>// {category}</a> <span>series</span></div>
      <h1>{seriesName}</h1>
      <div class="list-count">{posts.length} part{posts.length > 1 ? 's' : ''} &middot; read top to bottom</div>
    </header>

    <div class="series-cards">
      {posts.map((post, i) => (
        <div class="series-row">
          <div class="series-num">{String((post.data.seriesOrder ?? i + 1)).padStart(2, '0')}</div>
          <div class="series-card-wrap">
            <PostCard
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              date={post.data.date}
              category={post.data.category}
              readTime={post.data.readTime}
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .list-band { background: var(--pom); box-shadow: 0 0 0 100vmax var(--pom); clip-path: inset(0 -100vmax); margin: -60px 0 36px; padding: 34px 0 30px; }
  .list-kicker a, .list-kicker span { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; padding: 2px 9px; border-radius: 4px; text-decoration: none; }
  .list-kicker a { background: var(--lime); color: var(--on-lime); }
  .list-kicker span { background: var(--calamine); color: var(--on-calamine); margin-left: 4px; }
  .list-band h1 { color: var(--on-pom); font-size: 32px; margin: 12px 0 4px; }
  .list-count { color: var(--on-pom-dim); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }

  .series-count {
    color: var(--dimmer);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 36px;
    font-family: 'Source Code Pro', monospace;
  }
  .series-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .series-row {
    display: flex;
    align-items: stretch;
    gap: 14px;
  }
  .series-num {
    flex-shrink: 0;
    color: var(--a3);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding-top: 18px;
    min-width: 24px;
  }
  .series-card-wrap {
    flex: 1;
    min-width: 0;
  }
</style>
