{
  "name": "deep-sea",
  "type": "dark",
  "colors": { "editor.background": "#112f2c", "editor.foreground": "#d8eee4" },
  "tokenColors": [
    { "settings": { "foreground": "#d8eee4" } },
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#78cdd0", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag", "support.type.property-name", "meta.object-literal.key", "variable.other.property", "entity.other.attribute-name"], "settings": { "foreground": "#c7d14f" } },
    { "scope": ["string", "string.quoted", "string.unquoted", "markup.inline.raw"], "settings": { "foreground": "#f4a9c0" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#96d1aa" } },
    { "scope": ["keyword", "storage", "storage.type", "keyword.control", "keyword.operator.word"], "settings": { "foreground": "#00b49b", "fontStyle": "bold" } },
    { "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#78cdd0" } },
    { "scope": ["variable", "variable.parameter", "variable.other"], "settings": { "foreground": "#e6f6ef" } },
    { "scope": ["punctuation", "meta.brace", "keyword.operator"], "settings": { "foreground": "#9fc6b8" } },
    { "scope": ["entity.name.type", "support.class", "entity.name.class"], "settings": { "foreground": "#c7d14f" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#c7d14f", "fontStyle": "bold" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f4a9c0" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#c7d14f" } }
  ]
}
